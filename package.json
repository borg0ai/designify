{
  "name": "designify-monorepo",
  "private": true,
  "version": "6.5.0",
  "description": "Designify workspace",
  "author": "Albert Li",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "test": "turbo run test --filter=@borg0ai/tests --filter=@borg0ai/brainstorm-server",
    "release": "qingniao",
    "typecheck": "pnpm --filter @borg0ai/brainstorm-server typecheck",
    "build": "pnpm --filter @borg0ai/brainstorm-server build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@borg0ai/brainstorm-server": "workspace:*",
    "@changesets/cli": "^2.31.1",
    "@systembug/qingniao": "^0.1.15",
    "turbo": "2.11.4"
  }
}
